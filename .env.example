# Required: PostgreSQL connection string (provisioned automatically by Replit Database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: Secret used to sign Express sessions (set as a Replit Secret)
SESSION_SECRET=change-me-to-a-long-random-string

# Required: Set to the Replit `sub` claim of the user who should have /admin access
MASTER_ADMIN_ID=

# Auto-injected by Replit — do not set manually in production
# REPL_ID=
# ISSUER_URL=
